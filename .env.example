# =========================================================
# CAP Supervision - modele de configuration
# Copier en .env et completer. Le fichier .env n'est jamais
# versionne (voir .gitignore).
# =========================================================

# --- Base de donnees Neon --------------------------------
# Connexion directe : utilisee par les scripts (import, detection).
DATABASE_URL="postgresql://UTILISATEUR:MOTDEPASSE@HOTE.neon.tech/neondb?sslmode=require"

# Connexion via le pooler PgBouncer : utilisee par l'API.
# Facultative. Si absente, l'API bascule sur DATABASE_URL.
DATABASE_URL_POOLED="postgresql://UTILISATEUR:MOTDEPASSE@HOTE-pooler.neon.tech/neondb?sslmode=require"

# --- API -------------------------------------------------
# Origines autorisees par CORS, separees par des virgules.
# "*" ouvre l'API a toutes les origines.
CORS_ORIGINS="*"

# --- Interface Streamlit ---------------------------------
# URL publique de l'API. En local, laisser la valeur par defaut.
API_URL="http://127.0.0.1:8000"

# Identifiants de connexion a l'interface.
APP_USER_EMAIL="ocp@gmail.com"
APP_USER_PASSWORD="definir-un-mot-de-passe"